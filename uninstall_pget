#!/usr/bin/env bash

# ------------------------------------------------------------
# uninstall_pget
# ------------------------------------------------------------
# This script reverses the setup performed by setup_pget.
#
# It removes:
# - /usr/local/bin/pget
# - /opt/pget and all its contents
# - the setup_pget managed block from ~/.vimrc
#
# It does NOT uninstall system packages such as vim, gnupg,
# or pwgen. Those may be used by other software.
# 
# IT DOES NOT REMOVE ANY VAULTS SINCE THEY CAN STILL BE 
# ACCESSED WITH THE GPG COMMAND
#
# ------------------------------------------------------------
# Copyright 2002-2026 Kirk Waingrow
#
