  draw_header
  printf "\n\n"
  printf "CLI Usage: pget [-v vault_name] [-e | -l | -x | --help] pattern\n"
  printf "              -v   Select vault, example: -v personal\n"
  printf "              -E   Edit encrypted file\n"
  printf "              -l   List available vaults\n"
  printf "              -x   Kill gpg-agent cache for all vaults\n"
  printf "          --help   Display this help\n"
  printf "       --version   pget version\n"
  printf "         pattern   Pattern to search, use \" \" for multiple patterns\n\n"

  printf " Navigation                                Action\n"
  printf " ------------------------------------+-----------------------------------\n"
  printf "  Up/Dn or j,k Move up / down        |  a   Add entry\n"
  printf "  PgUp, PgDn   Page up / down        |  e   Edit/Modify selected entry\n"
  printf "  Home, End    Jump to top / bottom  |  d   Delete selected entry\n"
  printf "  l, Enter     Look/View full entry  |  c,y Copy/yank secret to clipboard\n"
  printf "  h,s          hide/show SECRET      |  v   Create/Select other vaults\n"
  printf "                                     | \n"
  printf "  /            Search new pattern(s) |  E   Edit Encrypted file\n"
  printf "                                     | \n"
  printf "  ?            Display this help     |  g   pwgen - password generator\n"
  printf "  x            Kill gpg-agent / exit | \n"
  printf "  q            Quit                  |  w   Warranty & License Details\n"
  printf " ------------------------------------+---------------------------------\n"
