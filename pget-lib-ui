#!/usr/bin/env bash

# ------------------------------------------------------------
# pget-lib-ui
# Terminal UI, drawing, navigation, vault selector, and cleanup
# ------------------------------------------------------------

# ------------------------------------------------------------
# CLEANUP
# Restores terminal state and optionally clears GPG cache.
# ------------------------------------------------------------
cleanup() {
  pget_gpg_maybe_kill_agent

  tput cnorm 2>/dev/null
  tput rmcup 2>/dev/null
  stty echo icanon 2>/dev/null
}



# ------------------------------------------------------------
# HEADER / STATUS
# ------------------------------------------------------------
draw_header() {
  tput cup 0 0
  #printf "pget Password Manager - Vault: %s" "$vault_name"
  printf "pget Password Manager - Vault: %s%s%s" "$VAULT_FG" "$vault_name" "$HIGHLIGHT_OFF"
  tput el
}

draw_status() {
  local state line current total

  if (( visible )); then
    state="${VISABLE_BG}${HIGHLIGHT_FG}VISIBLE${HIGHLIGHT_OFF}"
  else
    state="hidden "
  fi

  total=${#lines[@]}
  if [ "$total" -eq 0 ]; then
    current=0
  else
    current=$((index + 1))
  fi

  tput cup 1 0
  line=$(printf "? = help | %d of %d | %s | pattern: " "$current" "$total" "$state")
  printf "%s%s%s%s" "$line" "$PATTERN_FONT_FG" "$pattern" "$HIGHLIGHT_OFF"
  tput el
}

# ------------------------------------------------------------
# DRAW SINGLE LINE
# ------------------------------------------------------------
draw_line() {
  local screen_row="$1"
  local data_index="$2"
  local field1 field2 field3 field4 mid out line_text
  local marker avail

  tput cup "$screen_row" 0
  tput el

  (( data_index < 0 || data_index >= ${#lines[@]} )) && return

  split_entry_fields "${lines[$data_index]}" field1 field2 field3 field4

  if (( data_index == index && visible )); then
    mid="$field3"
  else
    printf -v mid '%*s' "${#field3}" ''
    mid=${mid// /'*'}
  fi

  line_text="$field1"
  [ -n "$field2" ] && line_text+=" | $field2"
  [ -n "$field3" ] && line_text+=" | $mid"
  [ -n "$field4" ] && line_text+=" | $field4"

  (( data_index == index )) && marker="> " || marker="  "

  avail=$((max_total - ${#marker}))
  (( ${#line_text} > avail )) && out="$(printf "%.*s" "$((avail - 3))" "$line_text")..." || out="$line_text"

  if (( data_index == index )); then
    printf "%s%s%s%s" "$HIGHLIGHT_ON" "$marker" "$out" "$HIGHLIGHT_OFF"
  else
    printf "%s%s" "$marker" "$out"
  fi

  tput el
}


# ------------------------------------------------------------
# DRAW MAIN WINDOW
# ------------------------------------------------------------
draw_window() {
  tput cup 0 0
  tput ed

  draw_header
  draw_status

  if [ ${#lines[@]} -eq 0 ]; then
    tput cup 3 0
    printf "No matches found.\n"
    printf "Use '/' to try another search pattern\n"
    printf "Use 'a' in interactive mode to add an entry.\n"
    return
  fi

  for ((row=0; row<win_size; row++)); do
    draw_line $((row + 3)) "$((top + row))"
  done
  
}

