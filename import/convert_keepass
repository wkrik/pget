#!/bin/bash

# -----------------------------------------------------------------------------
# convert_keepass
#
# Purpose:
#   Convert a quoted KeePass CSV export into a Unix tab-delimited pget import file.
#
# Copyright (C) 2026 Kirk Waingrow
#
# Input CSV expected fields:
#   1. Account
#   2. Login Name
#   3. Password
#   4. Web Site
#   5. Comments
#
# Output fields:
#   1. Account
#      Or, when -g is used:
#      Group: Account
#   2. Login Name
#   3. Password
#   4. Comments|Web Site
#
# INSTRUCTIONS:
#   1. Inside KeePass do one of the following:
#        'File > Export > CSV' or 'Group > Data Exchange > Export > CSV'
#
#   2. Run:
#        ./keepass_import input.csv output.tsv
#      If a group is exported, run:
#        ./keepass_import -g GroupName input.csv output.tsv
#
#   3. Run:
#        $ pget -E
#
#   4. Import output.tsv file. Inside vim, entry the command:
#        :r output.tsv
#
#   5. Save and quit vim with the command:
#        :wq!
# Usage:
#  ./keepass_import [-g group-name] input.csv output.tsv
#
# Examples:
#  ./keepass_import input.csv output.tsv
#  ./keepass_import -g Network input.csv output.tsv
#
# -----------------------------------------------------------------------------
VERSION=v1.0

set -u
set -o pipefail

GROUP_NAME=""

usage()
{
    cat <<EOF

INSTRUCTIONS:
   1. Inside KeePass do one of the following:
        'File > Export > CSV' or 'Group > Data Exchange > Export > CSV'

   2. Run: 
        $0 input.csv output.tsv
      If a group is exported, run:
        $0 -g GroupName input.csv output.tsv 

   3. Run: 
        $ pget -E

   4. Import output.tsv file. Inside vim, entry the command:
        :r output.tsv

   5. Save and quit vim with the command:
        :wq!
EOF
    echo "Usage:"
    echo "  $0 [-g group-name] input.csv output.tsv"
    echo
    echo "Examples:"
    echo "  $0 input.csv output.tsv"
    echo "  $0 -g Network input.csv output.tsv"
}

die()
{
    echo "ERROR: $*" >&2
    exit 1
}

while getopts ":g:h" opt
do
    case "$opt" in
        g)
            GROUP_NAME="$OPTARG"
            ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

INPUT_FILE="${1:-}"
OUTPUT_FILE="${2:-}"

[ -n "$INPUT_FILE" ] || {
    usage
    exit 1
}

[ -n "$OUTPUT_FILE" ] || {
    usage
    exit 1
}

[ -f "$INPUT_FILE" ] || die "Input file not found: $INPUT_FILE"

awk -v group_name="$GROUP_NAME" '
function clean(s)
{
    gsub(/\r\n/, " | ", s)
    gsub(/\r/, " | ", s)
    gsub(/\n/, " | ", s)
    gsub(/\t/, " ", s)
    sub(/^[ ]+/, "", s)
    sub(/[ ]+$/, "", s)
    return s
}

function parse_csv_record(rec, arr,    i, c, nextc, field, nf, inq)
{
    nf = 1
    field = ""
    inq = 0

    for (i = 1; i <= length(rec); i++) {
        c = substr(rec, i, 1)

        if (inq) {
            if (c == "\"") {
                nextc = substr(rec, i + 1, 1)

                if (nextc == "\"") {
                    field = field "\""
                    i++
                } else {
                    inq = 0
                }
            } else {
                field = field c
            }
        } else {
            if (c == "\"") {
                inq = 1
            } else if (c == ",") {
                arr[nf] = field
                nf++
                field = ""
            } else {
                field = field c
            }
        }
    }

    arr[nf] = field
    return nf
}

function flush_record(    f, nf, account, login_name, password, website, comments, field4)
{
    delete f

    nf = parse_csv_record(record, f)

    account = clean(f[1])
    login_name = clean(f[2])
    password = clean(f[3])
    website = clean(f[4])
    comments = clean(f[5])

    if (first_record == 1) {
        first_record = 0

        if (tolower(account) == "account" &&
            tolower(login_name) == "login name" &&
            tolower(password) == "password") {
            return
        }
    }

    if (group_name != "" && account != "") {
        account = group_name ": " account
    }

    field4 = ""

    if (comments != "" && website != "") {
        field4 = comments " | " website
    } else if (comments != "") {
        field4 = comments
    } else if (website != "") {
        field4 = website
    }

    print account "\t" login_name "\t" password "\t" field4
}

BEGIN {
    first_record = 1
    record = ""
    quote_count = 0
}

{
    line = $0

    if (record == "") {
        record = line
    } else {
        record = record "\n" line
    }

    temp = record
    quote_count = gsub(/"/, "\"", temp)

    if ((quote_count % 2) == 0) {
        flush_record()
        record = ""
    }
}

END {
    if (record != "") {
        flush_record()
    }
}
' "$INPUT_FILE" > "$OUTPUT_FILE" || die "Conversion failed."

echo "Created:"
echo "  $OUTPUT_FILE"


